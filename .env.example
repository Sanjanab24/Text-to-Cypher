# Copy to .env and fill in. Never commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Neo4j Desktop install paths (find yours under C:/Users/<you>/.Neo4jDesktop2)
NEO4J_HOME=C:/Users/<you>/.Neo4jDesktop2/Data/dbmss/dbms-<id>
NEO4J_JAVA_HOME=C:/Users/<you>/.Neo4jDesktop2/Cache/runtime/zulu21...-win_x64
